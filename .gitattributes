# Normalize line endings across OS (Windows CRLF, macOS/Linux LF)
* text=auto

# Source code — always LF
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf

# Build & config
*.cmake text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.wav binary
*.ogg binary
*.ttf binary
*.dll binary
*.a binary
*.lib binary
*.dylib binary
